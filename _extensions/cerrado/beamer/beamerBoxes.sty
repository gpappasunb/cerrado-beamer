%%% Custom admonition boxes{{{2
%
% This a general box with icons at top left, optional title
%
\DeclareTColorBox{admonitionbox}{ O{red} m !O{} } {
enhanced,colframe=#1!75!black,colback=#1!10,coltitle=#1,minipage,
lefttitle=-1mm,bottomtitle=-3mm,frame hidden,
fontupper=\footnotesize\sffamily,
fonttitle=\bfseries,title=\small{#2}, #3
}

\newenvironment{admonitionnote}[1][\unskip] { \begin{admonitionbox}[notecolor]{\faTags} #1         } { \end{admonitionbox} }
\newenvironment{admonitiontip}[1][\unskip]  { \begin{admonitionbox}[tipcolor]{\faThumbsUp #1}    } { \end{admonitionbox} }
\newenvironment{admonitionerror}[1][\unskip]{ \begin{admonitionbox}[errorcolor]{\faTimesCircle#1}   } { \end{admonitionbox} }
\newenvironment{admonitionwarn}[1][\unskip] { \begin{admonitionbox}[warncolor]{\faExclamationCircle #1} } { \end{admonitionbox} }
\newenvironment{admonitionterm}[1][\unskip] { \begin{admonitionbox}[termcolor]{\faTerminal #1} \ttfamily } { \end{admonitionbox} }
\newenvironment{admonitionquote}[1][\unskip] { \begin{admonitionbox}[quotecolor]{\itshape\faQuoteLeft \  #1} } { \end{admonitionbox} }



