\ProvidesPackage{beamerthemeBSB}[2025/08/13 v1.1 BSB compgen Beamer theme]

%% This part modified from beamerthemeTaiwan.sty by Hsuan-Tien Lin
\DeclareOptionBeamer{compress}{\beamer@compresstrue}
\ProcessOptionsBeamer

\RequirePackage{tikz}
% Fonts 
\RequirePackage{mathptmx}
\RequirePackage{lmodern}
\RequirePackage{soul}
\RequirePackage{menukeys}
\RequirePackage[most]{tcolorbox}
\RequirePackage{circledsteps}
\RequirePackage{moresize}
\RequirePackage{relsize}


\mode<presentation>

\usecolortheme{BSBLightBlue}
\usefonttheme{BSB}
\useinnertheme{BSB}
\useoutertheme{BSB}
% \useinnertheme{circles}
% \useoutertheme{SimpleInfo}

\setbeamersize{text margin left=1em,text margin right=1em}

%
% For menukeys %1
%
% Menu separator is ;
\changemenucolortheme{menus}{menucolors}
\changemenucolortheme{shadowedroundedkeys}{keyscolors}
\changemenucolortheme{pathswithfolder}{pathcolors}
% \copymenustyle{gray}{menucolors}
\renewmenumacro{\menu}{menus}
\renewmenumacro{\keys}[-]{shadowedroundedkeys}
% Show paths with folder icon
\renewmenumacro{\directory}{pathswithfolder}
\renewcommand{\path}{\directory}

% \newcommand\neontext{{\Huge\neon\color{red}}}

%###############################################################################


\mode
<all>
