% % This command is used to renew the default background for each frame
% % Without it after each background canvas change all the slides would be
% % modified
\BeforeBeginEnvironment{frame}{%
  \setbeamertemplate{background canvas}[default]
  % \setbeamercolor{frametitle}{bg=frametitle.bg,fg=frametitle.fg}
  % \usebeamercolor{frametitle}
  \setbeamertemplate{frametitle}[defaulttitle]%
  \setbeamertemplate{footline}[infolines theme]
  \setbeamercolor{normal text}{fg=TextColor}
  \usebeamercolor[fg]{normal text}
  % \setbeamercolor{frametitle}{fg=TextColor}
  \setbeamercolor*{frametitle}{fg=FrameTitleFG,bg=FrameTitleBG}
}

