%%%%%
%% Frame box {{{2
%% This is the frame box. The righthand (\tclower) is rendered only if the \SideLogo is defined. This command should contain the path for an image file
%%%%%
\defbeamertemplate{frametitle}{defaulttitle}
{
  \begin{tcolorbox}[tctitle]
        % \insertframetitle    
        \fittext{\insertframetitle}%
        \ifdef\SideLogo{%
        \tcblower%
        \includegraphics[width=\linewidth]{\SideLogo}%
        }
        {}
  \end{tcolorbox}

}


