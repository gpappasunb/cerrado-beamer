\tcbset{
  title/.style={ 
    enhanced,
    colback=black!10,
    frame hidden,
    halign=left,
    boxsep=0pt,
    boxrule=0pt,
    sharp corners,
    spread upwards,
    before skip=0pt%,halign=center
  }
}
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% Frame title {{{1
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% tcolorbox style {{{2
% to render the frame title block
% It uses a sidebyside layout, with a left-aligned title and a right-aligned
% logo, with a 0.5cm (righthand width) reserve space
\tcbset{
  tctitle/.style={ 
    enhanced,
    sidebyside,
    lower separated=false,
    sidebyside adapt=left,
    righthand width=0.5cm, % reserve space for a logo
    code={% Sets the correct coloring of the elements
        \usebeamercolor{frametitle}
        \colorlet{frametitlebg}{frametitle.bg}
        \colorlet{frametitlefg}{frametitle.fg}
    },
    % Title background color. See the color definition in the color theme used
    colback=frametitlebg,
    % Title text color. See the color definition in the color theme used
    colupper=frametitlefg,
    nobeforeafter,
    frame hidden,
    halign=left,
    boxsep=0pt,
    boxrule=0pt,
    sharp corners,
    spread upwards,
    before skip=0pt,%,halign=center
    % Alternatives for title background shadow. Comment to remove shadow
    % lifted shadow={1mm}{-1.5mm}{2mm}{.1mm}{frametitlefg!50!black}, 
    drop fuzzy midday shadow=frametitlefg!90!black, 
  }
}


