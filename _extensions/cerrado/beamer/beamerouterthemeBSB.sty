%%% section page template {{{2
\setbeamertemplate{section page}{
  
  %%% page background {{{3
  %% First creating the page background. This is a gradient with fixed colors
  \begin{tikzpicture}[remember picture,overlay]%     
    \shade[top color=blue!15,bottom color=green!10]
	  (current page.north west) rectangle (current page.south east); 
  \end{tikzpicture}%     


   %%% rectangle and title {{{3
   %% Creating a lifted rectangle with two colors (same as above) as the borders
   \begin{tikzpicture}[remember picture,overlay]

	  % Create an outer rectangle with the same colors as the title page
	  % but with a reduced size (40pts) and inverted top/bottom,
	  % and a nice (?) circular glow giving it a bumpy appearance
    \shade[
      bottom color=blue!15,
      top color=green!10,
      opaque,
      circular glow={fill=black!60}]
	  ([yshift=-40pt]current page.west) rectangle
	  ([yshift=40pt]current page.east);

	  % Creating the inner rectangle
    \shade[top color=blue!15,bottom color=green!10,nearly opaque]
	  ([xshift=10pt,yshift=-30pt]current page.west) rectangle
	  ([xshift=-10pt,yshift=30pt]current page.east);


	  % Placing the section text inside the rectangle
    \node[font={\usebeamercolor{section title}}] 
		 at (current page.center) (section) {
		 {\usebeamercolor{section}\usebeamerfont{section}\secname\par}
		%   %%% I had to \secname instead of \insertsection. TODO: the section
		%   % title color is not applied!!
	  };

	\end{tikzpicture}
} % end of section page


%%% section page at begin {{{2
% Important! Add a new frame for the section slide, which template is given by
% "section page"
\AtBeginSection{
	\begingroup
  % Removing elements
	\setbeamertemplate{headline}{}
	\setbeamertemplate{footline}{}
  % Background color is set, but overridden by the section page template 
  \usebeamercolor[bg]{background canvas}%{bg=white}
	\frame{\sectionpage}
	\endgroup
}



%
% Footer - footline {{{1
%
\setbeamertemplate{page number in head/foot}[totalframenumber]%

\defbeamertemplate*{footline}{infolines theme}
{%
  \leavevmode%
  \hbox{%
  
  % Author
  \begin{beamercolorbox}[wd=.233333\paperwidth,ht=2.25ex,dp=1ex,center]{author in head/foot}%
    \usebeamerfont{author in head/foot}\insertshortauthor
    % \usebeamerfont{author in head/foot}\insertshortauthor\expandafter\ifblank\expandafter{\beamer@shortinstitute}{}{~~(\insertshortinstitute)}
  \end{beamercolorbox}%

  % Middle line - 
  \begin{beamercolorbox}[wd=.533333\paperwidth,ht=2.25ex,dp=1ex,center]{section in head/foot}%
    % \usebeamerfont{title in head/foot}\insertsectionhead\expandafter\insertshorttitle
    \usebeamerfont{title in head/foot}\insertsectionhead
  \end{beamercolorbox}%

  % Slide pages
  \begin{beamercolorbox}[wd=.233333\paperwidth,ht=2.25ex,dp=1ex,right]{date in head/foot}%
    \usebeamerfont{date in head/foot}\insertshortdate{}\hspace*{2em}
    \usebeamercolor[fg]{page number in head/foot}\usebeamerfont{page number in head/foot}\usebeamertemplate{page number in head/foot}\hspace*{2ex} 
  \end{beamercolorbox}}%
  % \vskip0pt%
}

\defbeamertemplate{footline}{blank}{}

