% \setbeamertemplate{description body begin}[description frame]
% \defbeamertemplate{description body end}{description frame}{\end{tcolorbox}}
% \setbeamertemplate{description body end}[description frame]


%
% Section symbols {{{1
%
\setbeamertemplate{sections/subsections in toc}[ball]

%
% Blocks {{{1
%
\setbeamertemplate{blocks}[rounded][shadow=false]


\mode
<all>
